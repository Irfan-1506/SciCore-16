{
  "name": "SciCore16_M1",
  "rtl_files": {
    "alu16.v": "// SciCore-16 M1: 16-bit Fixed-Point ALU (Verilog-2001)\n// Opcodes:\n//   000: ADD  (a + b, signed overflow)\n//   001: SUB  (a - b, signed overflow)\n//   010: AND  (a & b)\n//   011: OR   (a | b)\n//   100: XOR  (a ^ b)\n//   101: SHL  (a << 1)\n//   110: ASR  (signed a >>> 1)\n//   111: NEG  (-a, signed overflow on 0x8000)\nmodule alu16 (\n    input  [15:0] a,\n    input  [15:0] b,\n    input  [2:0]  opcode,\n    output reg [15:0] result,\n    output        zero,\n    output        neg,\n    output reg    overflow\n);\n    wire [15:0] sum_val;\n    wire [15:0] diff_val;\n    wire [15:0] neg_val;\n    wire        add_ovf;\n    wire        sub_ovf;\n    wire        neg_ovf;\n\n    assign sum_val  = a + b;\n    assign diff_val = a - b;\n    assign neg_val  = 16'h0000 - a;\n\n    assign add_ovf = (a[15] == b[15]) && (sum_val[15] != a[15]);\n    assign sub_ovf = (a[15] != b[15]) && (diff_val[15] != a[15]);\n    assign neg_ovf = (a == 16'h8000);\n\n    always @(*) begin\n        result   = 16'h0000;\n        overflow = 1'b0;\n        case (opcode)\n            3'b000: begin\n                result   = sum_val;\n                overflow = add_ovf;\n            end\n            3'b001: begin\n                result   = diff_val;\n                overflow = sub_ovf;\n            end\n            3'b010: result = a & b;\n            3'b011: result = a | b;\n            3'b100: result = a ^ b;\n            3'b101: result = {a[14:0], 1'b0};\n            3'b110: result = {a[15], a[15:1]};\n            3'b111: begin\n                result   = neg_val;\n                overflow = neg_ovf;\n            end\n            default: begin\n                result   = 16'h0000;\n                overflow = 1'b0;\n            end\n        endcase\n    end\n\n    assign zero = (result == 16'h0000);\n    assign neg  = result[15];\nendmodule\n",
    "register_bank.v": "// SciCore-16 M1: 4x16-bit Register Bank (2 Read, 1 Write)\nmodule register_bank (\n    input         clk,\n    input         rst,\n    input         we,\n    input  [1:0]  waddr,\n    input  [15:0] wdata,\n    input  [1:0]  raddr_a,\n    input  [1:0]  raddr_b,\n    output [15:0] rdata_a,\n    output [15:0] rdata_b\n);\n    reg [15:0] r0;\n    reg [15:0] r1;\n    reg [15:0] r2;\n    reg [15:0] r3;\n\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            r0 <= 16'h0000;\n            r1 <= 16'h0000;\n            r2 <= 16'h0000;\n            r3 <= 16'h0000;\n        end else if (we) begin\n            case (waddr)\n                2'b00: r0 <= wdata;\n                2'b01: r1 <= wdata;\n                2'b10: r2 <= wdata;\n                2'b11: r3 <= wdata;\n            endcase\n        end\n    end\n\n    assign rdata_a = (raddr_a == 2'b00) ? r0 :\n                     (raddr_a == 2'b01) ? r1 :\n                     (raddr_a == 2'b10) ? r2 : r3;\n\n    assign rdata_b = (raddr_b == 2'b00) ? r0 :\n                     (raddr_b == 2'b01) ? r1 :\n                     (raddr_b == 2'b10) ? r2 : r3;\nendmodule\n"
  },
  "tb_files": {
    "tb_m1.v": "// SciCore-16 M1 Testbench: ALU + Register Bank\nmodule tb_m1;\n    reg  [15:0] a;\n    reg  [15:0] b;\n    reg  [2:0]  opcode;\n    wire [15:0] result;\n    wire        zero;\n    wire        neg;\n    wire        overflow;\n\n    alu16 dut_alu (\n        .a(a),\n        .b(b),\n        .opcode(opcode),\n        .result(result),\n        .zero(zero),\n        .neg(neg),\n        .overflow(overflow)\n    );\n\n    initial begin\n        // 1.0 + 2.0 = 3.0 (Q8.8: 0x0100 + 0x0200 = 0x0300)\n        a = 16'h0100; b = 16'h0200; opcode = 3'b000;\n        #10;\n        $display(\"ADD 1.0+2.0: res=%h z=%b n=%b ovf=%b\", result, zero, neg, overflow);\n\n        // 1.0 - 2.0 = -1.0 (0xFF00)\n        opcode = 3'b001;\n        #10;\n        $display(\"SUB 1.0-2.0: res=%h z=%b n=%b ovf=%b\", result, zero, neg, overflow);\n\n        // Positive overflow: 0x7FFF + 0x0001 = 0x8000, ovf=1\n        a = 16'h7FFF; b = 16'h0001; opcode = 3'b000;\n        #10;\n        $display(\"OVF ADD:     res=%h z=%b n=%b ovf=%b\", result, zero, neg, overflow);\n\n        // Zero test: 0x0380 - 0x0380 = 0x0000, z=1\n        a = 16'h0380; b = 16'h0380; opcode = 3'b001;\n        #10;\n        $display(\"ZERO SUB:    res=%h z=%b n=%b ovf=%b\", result, zero, neg, overflow);\n\n        // SHL: 0x0100 << 1 = 0x0200\n        a = 16'h0100; b = 16'h0000; opcode = 3'b101;\n        #10;\n        $display(\"SHL 1.0:     res=%h z=%b n=%b ovf=%b\", result, zero, neg, overflow);\n\n        // ASR: 0xFE00 (-2.0) >>> 1 = 0xFF00 (-1.0)\n        a = 16'hFE00; opcode = 3'b110;\n        #10;\n        $display(\"ASR -2.0:    res=%h z=%b n=%b ovf=%b\", result, zero, neg, overflow);\n\n        // NEG: -3.5 (0x0380 -> 0xFC80)\n        a = 16'h0380; opcode = 3'b111;\n        #10;\n        $display(\"NEG 3.5:     res=%h z=%b n=%b ovf=%b\", result, zero, neg, overflow);\n\n        // Logic AND / OR / XOR\n        a = 16'h00F0; b = 16'h003C; opcode = 3'b010; #10;\n        $display(\"AND:         res=%h\", result);\n        opcode = 3'b011; #10;\n        $display(\"OR:          res=%h\", result);\n        opcode = 3'b100; #10;\n        $display(\"XOR:         res=%h\", result);\n\n        $finish;\n    end\nendmodule\n"
  },
