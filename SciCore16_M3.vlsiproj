{
  "name": "SciCore16_M1",
  "rtl_files": {
    "alu16.v": "// SciCore-16 M1: 16-bit Fixed-Point ALU (Verilog-2001)\n// Opcodes:\n//   000: ADD  (a + b, signed overflow)\n//   001: SUB  (a - b, signed overflow)\n//   010: AND  (a & b)\n//   011: OR   (a | b)\n//   100: XOR  (a ^ b)\n//   101: SHL  (a << 1)\n//   110: ASR  (signed a >>> 1)\n//   111: NEG  (-a, signed overflow on 0x8000)\nmodule alu16 (\n    input  [15:0] a,\n    input  [15:0] b,\n    input  [2:0]  opcode,\n    output reg [15:0] result,\n    output        zero,\n    output        neg,\n    output reg    overflow\n);\n    wire [15:0] sum_val;\n    wire [15:0] diff_val;\n    wire [15:0] neg_val;\n    wire        add_ovf;\n    wire        sub_ovf;\n    wire        neg_ovf;\n\n    assign sum_val  = a + b;\n    assign diff_val = a - b;\n    assign neg_val  = 16'h0000 - a;\n\n    assign add_ovf = (a[15] == b[15]) && (sum_val[15] != a[15]);\n    assign sub_ovf = (a[15] != b[15]) && (diff_val[15] != a[15]);\n    assign neg_ovf = (a == 16'h8000);\n\n    always @(*) begin\n        result   = 16'h0000;\n        overflow = 1'b0;\n        case (opcode)\n            3'b000: begin\n                result   = sum_val;\n                overflow = add_ovf;\n            end\n            3'b001: begin\n                result   = diff_val;\n                overflow = sub_ovf;\n            end\n            3'b010: result = a & b;\n            3'b011: result = a | b;\n            3'b100: result = a ^ b;\n            3'b101: result = {a[14:0], 1'b0};\n            3'b110: result = {a[15], a[15:1]};\n            3'b111: begin\n                result   = neg_val;\n                overflow = neg_ovf;\n            end\n            default: begin\n                result   = 16'h0000;\n                overflow = 1'b0;\n            end\n        endcase\n    end\n\n    assign zero = (result == 16'h0000);\n    assign neg  = result[15];\nendmodule\n",
    "register_bank.v": "// SciCore-16 M1: 4x16-bit Register Bank (2 Read, 1 Write)\nmodule register_bank (\n    input         clk,\n    input         rst,\n    input         we,\n    input  [1:0]  waddr,\n    input  [15:0] wdata,\n    input  [1:0]  raddr_a,\n    input  [1:0]  raddr_b,\n    output [15:0] rdata_a,\n    output [15:0] rdata_b\n);\n    reg [15:0] r0;\n    reg [15:0] r1;\n    reg [15:0] r2;\n    reg [15:0] r3;\n\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            r0 <= 16'h0000;\n            r1 <= 16'h0000;\n            r2 <= 16'h0000;\n            r3 <= 16'h0000;\n        end else if (we) begin\n            case (waddr)\n                2'b00: r0 <= wdata;\n                2'b01: r1 <= wdata;\n                2'b10: r2 <= wdata;\n                2'b11: r3 <= wdata;\n            endcase\n        end\n    end\n\n    assign rdata_a = (raddr_a == 2'b00) ? r0 :\n                     (raddr_a == 2'b01) ? r1 :\n                     (raddr_a == 2'b10) ? r2 : r3;\n\n    assign rdata_b = (raddr_b == 2'b00) ? r0 :\n                     (raddr_b == 2'b01) ? r1 :\n                     (raddr_b == 2'b10) ? r2 : r3;\nendmodule\n",
    "multiplier.v": "// SciCore-16 M2: Signed Q8.8 Iterative Shift-Add Multiplier (16-cycle)\n// Rounding policy: round-to-nearest (half-up on magnitude before sign restore)\nmodule multiplier (\n    input         clk,\n    input         rst,\n    input         start,\n    input  [15:0] a,\n    input  [15:0] b,\n    output reg [15:0] result,\n    output reg    overflow,\n    output reg    busy,\n    output reg    done\n);\n    reg        res_sign;\n    reg [31:0] mcand;\n    reg [15:0] mplier;\n    reg [31:0] acc;\n    reg [4:0]  cnt;\n\n    wire [15:0] mag_a;\n    wire [15:0] mag_b;\n    wire [31:0] acc_rounded;\n    wire [23:0] scaled_mag;\n    wire        ovf_pos;\n    wire        ovf_neg;\n\n    assign mag_a       = a[15] ? (16'h0000 - a) : a;\n    assign mag_b       = b[15] ? (16'h0000 - b) : b;\n    assign acc_rounded = acc + 32'h00000080;\n    assign scaled_mag  = acc_rounded[31:8];\n    assign ovf_pos     = (!res_sign) && (scaled_mag > 24'h007FFF);\n    assign ovf_neg     = (res_sign)  && (scaled_mag > 24'h008000);\n\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            result   <= 16'h0000;\n            overflow <= 1'b0;\n            busy     <= 1'b0;\n            done     <= 1'b0;\n            res_sign <= 1'b0;\n            mcand    <= 32'h00000000;\n            mplier   <= 16'h0000;\n            acc      <= 32'h00000000;\n            cnt      <= 5'd0;\n        end else begin\n            done <= 1'b0;\n            if (start && !busy) begin\n                res_sign <= a[15] ^ b[15];\n                mcand    <= {16'h0000, mag_a};\n                mplier   <= mag_b;\n                acc      <= 32'h00000000;\n                cnt      <= 5'd16;\n                busy     <= 1'b1;\n                overflow <= 1'b0;\n            end else if (busy) begin\n                if (cnt != 5'd0) begin\n                    if (mplier[0]) begin\n                        acc <= acc + mcand;\n                    end\n                    mcand  <= {mcand[30:0], 1'b0};\n                    mplier <= {1'b0, mplier[15:1]};\n                    cnt    <= cnt - 5'd1;\n                end else begin\n                    result   <= res_sign ? (16'h0000 - scaled_mag[15:0]) : scaled_mag[15:0];\n                    overflow <= ovf_pos || ovf_neg;\n                    busy     <= 1'b0;\n                    done     <= 1'b1;\n                end\n            end\n        end\n    end\nendmodule\n",
    "divider.v": "// SciCore-16 M2: Signed Q8.8 Restoring Divider (24-cycle)\n// Computes Q8.8 result = (a << 8) / b with divide-by-zero and overflow flags\nmodule divider (\n    input         clk,\n    input         rst,\n    input         start,\n    input  [15:0] a,\n    input  [15:0] b,\n    output reg [15:0] result,\n    output reg    div_zero,\n    output reg    overflow,\n    output reg    busy,\n    output reg    done\n);\n    reg        res_sign;\n    reg [16:0] rem;\n    reg [23:0] quot;\n    reg [15:0] divisor;\n    reg [4:0]  cnt;\n\n    wire [15:0] mag_a;\n    wire [15:0] mag_b;\n    wire [16:0] trial_rem;\n    wire        can_sub;\n    wire        ovf_pos;\n    wire        ovf_neg;\n\n    assign mag_a     = a[15] ? (16'h0000 - a) : a;\n    assign mag_b     = b[15] ? (16'h0000 - b) : b;\n    assign trial_rem = {rem[15:0], quot[23]};\n    assign can_sub   = (trial_rem >= {1'b0, divisor});\n    assign ovf_pos   = (!res_sign) && (quot > 24'h007FFF);\n    assign ovf_neg   = (res_sign)  && (quot > 24'h008000);\n\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            result   <= 16'h0000;\n            div_zero <= 1'b0;\n            overflow <= 1'b0;\n            busy     <= 1'b0;\n            done     <= 1'b0;\n            res_sign <= 1'b0;\n            rem      <= 17'd0;\n            quot     <= 24'd0;\n            divisor  <= 16'd0;\n            cnt      <= 5'd0;\n        end else begin\n            done <= 1'b0;\n            if (start && !busy) begin\n                if (b == 16'h0000) begin\n                    result   <= 16'h0000;\n                    div_zero <= 1'b1;\n                    overflow <= 1'b0;\n                    busy     <= 1'b0;\n                    done     <= 1'b1;\n                end else begin\n                    res_sign <= a[15] ^ b[15];\n                    rem      <= 17'd0;\n                    quot     <= {mag_a, 8'h00};\n                    divisor  <= mag_b;\n                    cnt      <= 5'd24;\n                    div_zero <= 1'b0;\n                    overflow <= 1'b0;\n                    busy     <= 1'b1;\n                end\n            end else if (busy) begin\n                if (cnt != 5'd0) begin\n                    if (can_sub) begin\n                        rem  <= trial_rem - {1'b0, divisor};\n                        quot <= {quot[22:0], 1'b1};\n                    end else begin\n                        rem  <= trial_rem;\n                        quot <= {quot[22:0], 1'b0};\n                    end\n                    cnt <= cnt - 5'd1;\n                end else begin\n                    result   <= res_sign ? (16'h0000 - quot[15:0]) : quot[15:0];\n                    overflow <= ovf_pos || ovf_neg;\n                    busy     <= 1'b0;\n                    done     <= 1'b1;\n                end\n            end\n        end\n    end\nendmodule\n",
    "cordic.v": "// SciCore-16 M3: Circular Rotation-Mode CORDIC Engine (12-iteration)\n// Input:  theta in Q8.8 signed radians, range [-pi/2, +pi/2] ([-1.57, +1.57])\n// Output: sin_out, cos_out in Q8.8 signed fixed-point (internal Q2.14 precision)\nmodule cordic (\n    input         clk,\n    input         rst,\n    input         start,\n    input  [15:0] theta,\n    output reg [15:0] sin_out,\n    output reg [15:0] cos_out,\n    output reg    busy,\n    output reg    done\n);\n    reg [15:0] x;\n    reg [15:0] y;\n    reg [15:0] z;\n    reg [3:0]  iter;\n\n    // Q2.14 arctan(2^-i) lookup table (round(atan(2^-i) * 16384))\n    wire [15:0] atan_val;\n    assign atan_val = (iter == 4'd0)  ? 16'h3244 :\n                      (iter == 4'd1)  ? 16'h1DAC :\n                      (iter == 4'd2)  ? 16'h0FAE :\n                      (iter == 4'd3)  ? 16'h07F5 :\n                      (iter == 4'd4)  ? 16'h03FF :\n                      (iter == 4'd5)  ? 16'h0200 :\n                      (iter == 4'd6)  ? 16'h0100 :\n                      (iter == 4'd7)  ? 16'h0080 :\n                      (iter == 4'd8)  ? 16'h0040 :\n                      (iter == 4'd9)  ? 16'h0020 :\n                      (iter == 4'd10) ? 16'h0010 : 16'h0008;\n\n    // Explicit signed arithmetic right shifts x >>> iter and y >>> iter\n    wire [15:0] x_shift;\n    wire [15:0] y_shift;\n\n    assign x_shift = (iter == 4'd0)  ? x :\n                     (iter == 4'd1)  ? {x[15], x[15:1]} :\n                     (iter == 4'd2)  ? {{2{x[15]}}, x[15:2]} :\n                     (iter == 4'd3)  ? {{3{x[15]}}, x[15:3]} :\n                     (iter == 4'd4)  ? {{4{x[15]}}, x[15:4]} :\n                     (iter == 4'd5)  ? {{5{x[15]}}, x[15:5]} :\n                     (iter == 4'd6)  ? {{6{x[15]}}, x[15:6]} :\n                     (iter == 4'd7)  ? {{7{x[15]}}, x[15:7]} :\n                     (iter == 4'd8)  ? {{8{x[15]}}, x[15:8]} :\n                     (iter == 4'd9)  ? {{9{x[15]}}, x[15:9]} :\n                     (iter == 4'd10) ? {{10{x[15]}}, x[15:10]} :\n                                       {{11{x[15]}}, x[15:11]};\n\n    assign y_shift = (iter == 4'd0)  ? y :\n                     (iter == 4'd1)  ? {y[15], y[15:1]} :\n                     (iter == 4'd2)  ? {{2{y[15]}}, y[15:2]} :\n                     (iter == 4'd3)  ? {{3{y[15]}}, y[15:3]} :\n                     (iter == 4'd4)  ? {{4{y[15]}}, y[15:4]} :\n                     (iter == 4'd5)  ? {{5{y[15]}}, y[15:5]} :\n                     (iter == 4'd6)  ? {{6{y[15]}}, y[15:6]} :\n                     (iter == 4'd7)  ? {{7{y[15]}}, y[15:7]} :\n                     (iter == 4'd8)  ? {{8{y[15]}}, y[15:8]} :\n                     (iter == 4'd9)  ? {{9{y[15]}}, y[15:9]} :\n                     (iter == 4'd10) ? {{10{y[15]}}, y[15:10]} :\n                                       {{11{y[15]}}, y[15:11]};\n\n    // Convert Q2.14 back to Q8.8 with rounding (+32 then >>> 6)\n    wire [15:0] x_round;\n    wire [15:0] y_round;\n    assign x_round = x + 16'h0020;\n    assign y_round = y + 16'h0020;\n\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            sin_out <= 16'h0000;\n            cos_out <= 16'h0000;\n            busy    <= 1'b0;\n            done    <= 1'b0;\n            x       <= 16'h0000;\n            y       <= 16'h0000;\n            z       <= 16'h0000;\n            iter    <= 4'd0;\n        end else begin\n            done <= 1'b0;\n            if (start && !busy) begin\n                // K = 0.607253 in Q2.14 = 9949 = 16'h26DD\n                x    <= 16'h26DD;\n                y    <= 16'h0000;\n                z    <= {theta[9:0], 6'b000000};\n                iter <= 4'd0;\n                busy <= 1'b1;\n            end else if (busy) begin\n                if (iter < 4'd12) begin\n                    if (z[15] == 1'b0) begin\n                        // z >= 0: rotate CCW\n                        x <= x - y_shift;\n                        y <= y + x_shift;\n                        z <= z - atan_val;\n                    end else begin\n                        // z < 0: rotate CW\n                        x <= x + y_shift;\n                        y <= y - x_shift;\n                        z <= z + atan_val;\n                    end\n                    iter <= iter + 4'd1;\n                end else begin\n                    cos_out <= {{6{x_round[15]}}, x_round[15:6]};\n                    sin_out <= {{6{y_round[15]}}, y_round[15:6]};\n                    busy    <= 1'b0;\n                    done    <= 1'b1;\n                end\n            end\n        end\n    end\nendmodule\n"
  },
  "tb_files": {
    "tb_m1.v": "// SciCore-16 M1 Testbench: ALU + Register Bank\nmodule tb_m1;\n    reg  [15:0] a;\n    reg  [15:0] b;\n    reg  [2:0]  opcode;\n    wire [15:0] result;\n    wire        zero;\n    wire        neg;\n    wire        overflow;\n\n    alu16 dut_alu (\n        .a(a),\n        .b(b),\n        .opcode(opcode),\n        .result(result),\n        .zero(zero),\n        .neg(neg),\n        .overflow(overflow)\n    );\n\n    initial begin\n        // 1.0 + 2.0 = 3.0 (Q8.8: 0x0100 + 0x0200 = 0x0300)\n        a = 16'h0100; b = 16'h0200; opcode = 3'b000;\n        #10;\n        $display(\"ADD 1.0+2.0: res=%h z=%b n=%b ovf=%b\", result, zero, neg, overflow);\n\n        // 1.0 - 2.0 = -1.0 (0xFF00)\n        opcode = 3'b001;\n        #10;\n        $display(\"SUB 1.0-2.0: res=%h z=%b n=%b ovf=%b\", result, zero, neg, overflow);\n\n        // Positive overflow: 0x7FFF + 0x0001 = 0x8000, ovf=1\n        a = 16'h7FFF; b = 16'h0001; opcode = 3'b000;\n        #10;\n        $display(\"OVF ADD:     res=%h z=%b n=%b ovf=%b\", result, zero, neg, overflow);\n\n        // Zero test: 0x0380 - 0x0380 = 0x0000, z=1\n        a = 16'h0380; b = 16'h0380; opcode = 3'b001;\n        #10;\n        $display(\"ZERO SUB:    res=%h z=%b n=%b ovf=%b\", result, zero, neg, overflow);\n\n        // SHL: 0x0100 << 1 = 0x0200\n        a = 16'h0100; b = 16'h0000; opcode = 3'b101;\n        #10;\n        $display(\"SHL 1.0:     res=%h z=%b n=%b ovf=%b\", result, zero, neg, overflow);\n\n        // ASR: 0xFE00 (-2.0) >>> 1 = 0xFF00 (-1.0)\n        a = 16'hFE00; opcode = 3'b110;\n        #10;\n        $display(\"ASR -2.0:    res=%h z=%b n=%b ovf=%b\", result, zero, neg, overflow);\n\n        // NEG: -3.5 (0x0380 -> 0xFC80)\n        a = 16'h0380; opcode = 3'b111;\n        #10;\n        $display(\"NEG 3.5:     res=%h z=%b n=%b ovf=%b\", result, zero, neg, overflow);\n\n        // Logic AND / OR / XOR\n        a = 16'h00F0; b = 16'h003C; opcode = 3'b010; #10;\n        $display(\"AND:         res=%h\", result);\n        opcode = 3'b011; #10;\n        $display(\"OR:          res=%h\", result);\n        opcode = 3'b100; #10;\n        $display(\"XOR:         res=%h\", result);\n\n        $finish;\n    end\nendmodule\n",
    "tb_regbank.v": "// SciCore-16 M1 Testbench: 4x16-bit Register Bank\nmodule tb_regbank;\n    reg         clk;\n    reg         rst;\n    reg         we;\n    reg  [1:0]  waddr;\n    reg  [15:0] wdata;\n    reg  [1:0]  raddr_a;\n    reg  [1:0]  raddr_b;\n    wire [15:0] rdata_a;\n    wire [15:0] rdata_b;\n\n    register_bank dut_rb (\n        .clk(clk),\n        .rst(rst),\n        .we(we),\n        .waddr(waddr),\n        .wdata(wdata),\n        .raddr_a(raddr_a),\n        .raddr_b(raddr_b),\n        .rdata_a(rdata_a),\n        .rdata_b(rdata_b)\n    );\n\n    initial begin\n        clk = 0; rst = 1; we = 0;\n        waddr = 2'b00; wdata = 16'h0000;\n        raddr_a = 2'b00; raddr_b = 2'b01;\n        #10;\n        $display(\"RST:     ra=%h rb=%h\", rdata_a, rdata_b);\n\n        // Release reset, write r0 = 0x0100 (1.0)\n        rst = 0; we = 1; waddr = 2'b00; wdata = 16'h0100;\n        #5; clk = 1; #5; clk = 0;\n\n        // Write r1 = 0x0280 (2.5)\n        waddr = 2'b01; wdata = 16'h0280;\n        #5; clk = 1; #5; clk = 0;\n\n        // Write r2 = 0xFF00 (-1.0)\n        waddr = 2'b10; wdata = 16'hFF00;\n        #5; clk = 1; #5; clk = 0;\n\n        // Write r3 = 0x0380 (3.5)\n        waddr = 2'b11; wdata = 16'h0380;\n        #5; clk = 1; #5; clk = 0;\n\n        // Disable write, verify dual-port reads\n        we = 0; wdata = 16'hBEEF;\n        raddr_a = 2'b00; raddr_b = 2'b01;\n        #5; clk = 1; #5; clk = 0;\n        $display(\"RD r0,r1: ra=%h rb=%h\", rdata_a, rdata_b);\n\n        raddr_a = 2'b10; raddr_b = 2'b11;\n        #10;\n        $display(\"RD r2,r3: ra=%h rb=%h\", rdata_a, rdata_b);\n\n        // Re-assert reset\n        rst = 1; #10;\n        $display(\"RST2:    ra=%h rb=%h\", rdata_a, rdata_b);\n\n        $finish;\n    end\nendmodule\n",
    "tb_m2.v": "// SciCore-16 M2 Testbench: Iterative Multiplier & Restoring Divider\nmodule tb_m2;\n    reg         clk;\n    reg         rst;\n\n    reg         mul_start;\n    reg  [15:0] mul_a;\n    reg  [15:0] mul_b;\n    wire [15:0] mul_res;\n    wire        mul_ovf;\n    wire        mul_busy;\n    wire        mul_done;\n\n    reg         div_start;\n    reg  [15:0] div_a;\n    reg  [15:0] div_b;\n    wire [15:0] div_res;\n    wire        div_zero;\n    wire        div_ovf;\n    wire        div_busy;\n    wire        div_done;\n\n    integer i;\n\n    multiplier dut_mul (\n        .clk(clk), .rst(rst), .start(mul_start),\n        .a(mul_a), .b(mul_b),\n        .result(mul_res), .overflow(mul_ovf),\n        .busy(mul_busy), .done(mul_done)\n    );\n\n    divider dut_div (\n        .clk(clk), .rst(rst), .start(div_start),\n        .a(div_a), .b(div_b),\n        .result(div_res), .div_zero(div_zero), .overflow(div_ovf),\n        .busy(div_busy), .done(div_done)\n    );\n\n    initial begin\n        clk = 0; rst = 1;\n        mul_start = 0; mul_a = 16'h0000; mul_b = 16'h0000;\n        div_start = 0; div_a = 16'h0000; div_b = 16'h0000;\n        #5; clk = 1; #5; clk = 0;\n        rst = 0;\n\n        // --- MUL Test 1: 1.5 * 2.0 = 3.0 (0x0180 * 0x0200 = 0x0300) ---\n        mul_a = 16'h0180; mul_b = 16'h0200; mul_start = 1;\n        #5; clk = 1; #5; clk = 0;\n        mul_start = 0;\n        for (i = 0; i < 18; i = i + 1) begin\n            #5; clk = 1; #5; clk = 0;\n        end\n        $display(\"MUL  1.5*2.0:  res=%h ovf=%b\", mul_res, mul_ovf);\n\n        // --- MUL Test 2: -2.5 * 3.0 = -7.5 (0xFD80 * 0x0300 = 0xF880) ---\n        mul_a = 16'hFD80; mul_b = 16'h0300; mul_start = 1;\n        #5; clk = 1; #5; clk = 0;\n        mul_start = 0;\n        for (i = 0; i < 18; i = i + 1) begin\n            #5; clk = 1; #5; clk = 0;\n        end\n        $display(\"MUL -2.5*3.0:  res=%h ovf=%b\", mul_res, mul_ovf);\n\n        // --- MUL Test 3: Overflow 20.0 * 10.0 = 200.0 (ovf=1) ---\n        mul_a = 16'h1400; mul_b = 16'h0A00; mul_start = 1;\n        #5; clk = 1; #5; clk = 0;\n        mul_start = 0;\n        for (i = 0; i < 18; i = i + 1) begin\n            #5; clk = 1; #5; clk = 0;\n        end\n        $display(\"MUL OVF 20*10: res=%h ovf=%b\", mul_res, mul_ovf);\n\n        // --- DIV Test 1: 7.0 / 2.0 = 3.5 (0x0700 / 0x0200 = 0x0380) ---\n        div_a = 16'h0700; div_b = 16'h0200; div_start = 1;\n        #5; clk = 1; #5; clk = 0;\n        div_start = 0;\n        for (i = 0; i < 26; i = i + 1) begin\n            #5; clk = 1; #5; clk = 0;\n        end\n        $display(\"DIV  7.0/2.0:  res=%h dz=%b ovf=%b\", div_res, div_zero, div_ovf);\n\n        // --- DIV Test 2: -3.0 / 2.0 = -1.5 (0xFD00 / 0x0200 = 0xFE80) ---\n        div_a = 16'hFD00; div_b = 16'h0200; div_start = 1;\n        #5; clk = 1; #5; clk = 0;\n        div_start = 0;\n        for (i = 0; i < 26; i = i + 1) begin\n            #5; clk = 1; #5; clk = 0;\n        end\n        $display(\"DIV -3.0/2.0:  res=%h dz=%b ovf=%b\", div_res, div_zero, div_ovf);\n\n        // --- DIV Test 3: Divide by zero (1.0 / 0.0 -> dz=1) ---\n        div_a = 16'h0100; div_b = 16'h0000; div_start = 1;\n        #5; clk = 1; #5; clk = 0;\n        div_start = 0;\n        #5; clk = 1; #5; clk = 0;\n        $display(\"DIV  1.0/0.0:  res=%h dz=%b ovf=%b\", div_res, div_zero, div_ovf);\n\n        // --- DIV Test 4: Overflow 100.0 / 0.5 = 200.0 (ovf=1) ---\n        div_a = 16'h6400; div_b = 16'h0080; div_start = 1;\n        #5; clk = 1; #5; clk = 0;\n        div_start = 0;\n        for (i = 0; i < 26; i = i + 1) begin\n            #5; clk = 1; #5; clk = 0;\n        end\n        $display(\"DIV OVF 100/.5: res=%h dz=%b ovf=%b\", div_res, div_zero, div_ovf);\n\n        $finish;\n    end\nendmodule\n",
    "tb_m3.v": "// SciCore-16 M3 Testbench: CORDIC sin/cos (Q8.8 radians)\nmodule tb_m3;\n    reg         clk;\n    reg         rst;\n    reg         start;\n    reg  [15:0] theta;\n    wire [15:0] sin_out;\n    wire [15:0] cos_out;\n    wire        busy;\n    wire        done;\n    integer     i;\n\n    cordic dut_cordic (\n        .clk(clk), .rst(rst), .start(start),\n        .theta(theta),\n        .sin_out(sin_out), .cos_out(cos_out),\n        .busy(busy), .done(done)\n    );\n\n    initial begin\n        clk = 0; rst = 1; start = 0; theta = 16'h0000;\n        #5; clk = 1; #5; clk = 0;\n        rst = 0;\n\n        // Test 1: theta = 0 rad (0x0000) -> sin=0.0 (0x0000), cos=1.0 (0x0100)\n        theta = 16'h0000; start = 1;\n        #5; clk = 1; #5; clk = 0;\n        start = 0;\n        for (i = 0; i < 14; i = i + 1) begin #5; clk = 1; #5; clk = 0; end\n        $display(\"CORDIC  0:     sin=%h cos=%h\", sin_out, cos_out);\n\n        // Test 2: theta = pi/6 (~0.5236 -> 0x0086) -> sin=0.5 (0x0080), cos=0.866 (0x00DE)\n        theta = 16'h0086; start = 1;\n        #5; clk = 1; #5; clk = 0;\n        start = 0;\n        for (i = 0; i < 14; i = i + 1) begin #5; clk = 1; #5; clk = 0; end\n        $display(\"CORDIC  pi/6:  sin=%h cos=%h\", sin_out, cos_out);\n\n        // Test 3: theta = pi/4 (~0.7854 -> 0x00C9) -> sin=0.707 (0x00B5), cos=0.707 (0x00B5)\n        theta = 16'h00C9; start = 1;\n        #5; clk = 1; #5; clk = 0;\n        start = 0;\n        for (i = 0; i < 14; i = i + 1) begin #5; clk = 1; #5; clk = 0; end\n        $display(\"CORDIC  pi/4:  sin=%h cos=%h\", sin_out, cos_out);\n\n        // Test 4: theta = pi/2 (~1.5708 -> 0x0192) -> sin=1.0 (0x0100), cos=0.0 (0x0000)\n        theta = 16'h0192; start = 1;\n        #5; clk = 1; #5; clk = 0;\n        start = 0;\n        for (i = 0; i < 14; i = i + 1) begin #5; clk = 1; #5; clk = 0; end\n        $display(\"CORDIC  pi/2:  sin=%h cos=%h\", sin_out, cos_out);\n\n        // Test 5: theta = -pi/4 (-201 -> 0xFF37) -> sin=-0.707 (0xFF4B), cos=+0.707 (0x00B5)\n        theta = 16'hFF37; start = 1;\n        #5; clk = 1; #5; clk = 0;\n        start = 0;\n        for (i = 0; i < 14; i = i + 1) begin #5; clk = 1; #5; clk = 0; end\n        $display(\"CORDIC -pi/4:  sin=%h cos=%h\", sin_out, cos_out);\n\n        $finish;\n    end\nendmodule\n"
  },
